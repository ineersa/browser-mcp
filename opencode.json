{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "llama.cpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama-server (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8052/v1"
            },
            "models": {
                "flash": {
                    "name": "flash",
                    "modalities": {
                        "input": ["text", "image"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 131072,
                        "output": 65536
                    }
                }
            }
        }
    },
    "agent": {
        "web-researcher": {
            "description": "Use whenever web research or websearch is needed; gather evidence with citations.",
            "mode": "subagent",
            "model": "llama.cpp/flash",
            "temperature": 0.6,
            "tools": {
                "*": false,
                "websearch_*": true,
                "skill": true
            }
        }
    },
    "experimental": {
        "mcp_timeout": 3600000
    }
}
